{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logicc2api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "LOGICC", "class_name": "LogiccService" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LogiccService"] }],
  "secrets": { "required": ["LOGICC_ADMIN_PASSWORD", "LOGICC_API_KEY"] }
}
